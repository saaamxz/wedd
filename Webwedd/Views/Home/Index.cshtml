@{
    ViewData["Title"] = "Ebtisam & Ahmed";
}

<main class="wedding-page">
    <!-- =====================================================
     INVITATION COVER
====================================================== -->

    <section class="invitation-cover" id="invitationCover">

        <div class="cover-background"></div>

        <div class="cover-overlay"></div>

        <div class="cover-content">

            <div class="cover-top">
                <span>
                    TOGETHER WITH THEIR FAMILIES
                </span>
            </div>

            <div class="monogram">
                S
                <span>&</span>
                ?
            </div>

            <p class="cover-intro">
                REQUEST THE PLEASURE OF YOUR COMPANY
            </p>

            <h1 class="couple-names">

                <span class="name">
                    Saaam
                </span>

                <span class="ampersand">
                    &
                </span>

                <span class="name">
                    ??!
                </span>

            </h1>

            <div class="cover-divider">
                <span></span>
                <i>✦</i>
                <span></span>
            </div>

            <p class="cover-event">
                AT THEIR WEDDING CELEBRATION
            </p>

            <div class="cover-date">

                <span>08</span>

                <i></i>

                <span>NOVEMBER</span>

                <i></i>

                <span>2026</span>

            </div>

            <a href="#weddingHero"
               class="open-invitation"
               id="openInvitation">

                <span>
                    OPEN INVITATION
                </span>

                <i>
                    ↓
                </i>

            </a>

        </div>

    </section>


    <!-- =====================================================
     BACKGROUND MUSIC
====================================================== -->

    <audio id="weddingMusic"
           loop
           preload="auto">

        <source src="/music/wedding-song.mp3.mp3"
                type="audio/mpeg">

    </audio>

    <button id="musicToggle"
            class="music-toggle"
            type="button"
            aria-label="Toggle music">

        <span class="music-icon">♫</span>

    </button>



    <!-- =====================================================
         WEDDING HERO
    ====================================================== -->

    <section class="wedding-hero" id="weddingHero">

        <div class="hero-image">

            <img src="~/images/couple1.jpg"
                 alt="Saaam and ??!" />

            <div class="hero-overlay"></div>

        </div>

        <div class="hero-content">

            <p class="hero-small-text">
                THE BEGINNING OF FOREVER
            </p>

            <h2 class="hero-names">

                <span>
                    Saaam
                </span>

                <span class="hero-ampersand">
                    &
                </span>

                <span>
                    ??!
                </span>

            </h2>

            <div class="hero-line"></div>

            <p class="hero-date">
                08 · NOVEMBER · 2026
            </p>

            <p class="hero-quote">
                Two hearts, one beautiful journey.
            </p>

        </div>

    </section>


    <!-- =====================================================
         OUR STORY
    ====================================================== -->

    <section class="story-section">

        <div class="story-inner">

            <div class="story-image">

                <img src="~/images/couple.jpg"
                     alt="Saaam and ??!" />

            </div>

            <div class="story-content">

                <p class="section-label">
                    OUR STORY
                </p>

                <h2>
                    Two Hearts,
                    <br />
                    One Story
                </h2>

                <div class="gold-line"></div>

                <p class="story-text">
                    What started as two separate journeys
                    became one beautiful story.
                </p>

                <p class="story-text">
                    Through every moment, every smile,
                    and every memory, we found our way
                    to this beautiful beginning.
                </p>

                <div class="story-signature">
                    Saaam <span>&</span> ??!
                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         WEDDING INTRO
    ====================================================== -->

    <section class="wedding-intro">

        <div class="intro-content">

            <p class="section-label">
                OUR SPECIAL DAY
            </p>

            <h2>
                A Celebration
                <br />
                of Love
            </h2>

            <div class="gold-line"></div>

            <p>
                We are delighted to invite you to celebrate
                this beautiful beginning with us.
            </p>

        </div>

    </section>


    <!-- =====================================================
         WEDDING DATE
    ====================================================== -->

    <section class="date-section">

        <div class="date-content">

            <p class="section-label">
                SAVE THE DATE
            </p>

            <h2>
                08
            </h2>

            <p class="month">
                NOVEMBER
            </p>

            <p class="year">
                2026
            </p>

        </div>

    </section>


    <!-- =====================================================
         WEDDING DETAILS
    ====================================================== -->

    <section class="event-section">

        <div class="event-inner">

            <div class="event-heading">

                <p class="section-label">
                    THE CELEBRATION
                </p>

                <h2>
                    Join Us
                </h2>

                <div class="gold-line"></div>

                <p>
                    We would be honored to have you with us
                    as we celebrate the beginning of our forever.
                </p>

            </div>


            <div class="event-cards">

                <!-- DATE -->

                <div class="event-card">

                    <div class="event-icon">
                        01
                    </div>

                    <p class="event-label">
                        DATE
                    </p>

                    <h3>
                        November 8
                    </h3>

                    <span>
                        2026
                    </span>

                </div>


                <!-- TIME -->

                <div class="event-card">

                    <div class="event-icon">
                        02
                    </div>

                    <p class="event-label">
                        TIME
                    </p>

                    <h3>
                        06:00 PM
                    </h3>

                    <span>
                        Sunday Evening
                    </span>

                </div>


                <!-- VENUE -->

                <div class="event-card">

                    <div class="event-icon">
                        03
                    </div>

                    <p class="event-label">
                        VENUE
                    </p>

                    <h3>
                        Grand Star
                    </h3>

                    <span>
                        Assiut, Egypt
                    </span>

                </div>

            </div>


            <a href="#location"
               class="event-link">

                VIEW LOCATION

                <span>
                    →
                </span>

            </a>

        </div>

    </section>


    <!-- =====================================================
         LOCATION
    ====================================================== -->

    <section class="location-section" id="location">

        <div class="location-inner">

            <div class="location-heading">

                <p class="section-label">
                    FIND US
                </p>

                <h2>
                    The Location
                </h2>

                <div class="gold-line"></div>

                <p>
                    We can't wait to celebrate this beautiful
                    day with you.
                </p>

            </div>


            <div class="location-card">

                <div class="location-info">

                    <span class="location-number">
                        03
                    </span>

                    <p class="location-label">
                        WEDDING VENUE
                    </p>

                    <h3>
                        Grand Star
                    </h3>

                    <p class="location-address">
                        Assiut, Egypt
                    </p>

                    <a href="https://www.google.com/maps"
                       target="_blank"
                       rel="noopener noreferrer"
                       class="map-button">

                        <span>
                            OPEN IN GOOGLE MAPS
                        </span>

                        <i>
                            ↗
                        </i>

                    </a>

                </div>


                <div class="location-map">

                    <iframe src="https://www.google.com/maps?q=Assiut,Egypt&output=embed"
                            loading="lazy"
                            allowfullscreen
                            referrerpolicy="no-referrer-when-downgrade">
                    </iframe>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         COUNTDOWN
    ====================================================== -->

    <section class="countdown-section">

        <div class="countdown-inner">

            <p class="section-label">
                SAVE THE DATE
            </p>

            <h2>
                Counting Down
            </h2>

            <div class="gold-line"></div>

            <p class="countdown-message">
                Every second brings us closer to our special day.
            </p>


            <div class="countdown">

                <div class="countdown-item">

                    <span id="days">
                        00
                    </span>

                    <small>
                        DAYS
                    </small>

                </div>


                <div class="countdown-separator">
                    :
                </div>


                <div class="countdown-item">

                    <span id="hours">
                        00
                    </span>

                    <small>
                        HOURS
                    </small>

                </div>


                <div class="countdown-separator">
                    :
                </div>


                <div class="countdown-item">

                    <span id="minutes">
                        00
                    </span>

                    <small>
                        MINUTES
                    </small>

                </div>


                <div class="countdown-separator">
                    :
                </div>


                <div class="countdown-item">

                    <span id="seconds">
                        00
                    </span>

                    <small>
                        SECONDS
                    </small>

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         GALLERY
    ====================================================== -->

    <section class="gallery-section">

        <div class="gallery-heading">

            <p class="section-label">
                OUR MEMORIES
            </p>

            <h2>
                Moments
            </h2>

        </div>


        <div class="gallery-grid">

            <div class="gallery-item">

                <img src="~/images/gallery-1.jpg"
                     alt="Wedding memory 1" />

            </div>


            <div class="gallery-item">

                <img src="~/images/gallery-2.jpg"
                     alt="Wedding memory 2" />

            </div>


            <div class="gallery-item">

                <img src="~/images/gallery-3.jpg"
                     alt="Wedding memory 3" />

            </div>


            <div class="gallery-item">

                <img src="~/images/gallery-4.jpg"
                     alt="Wedding memory 4" />

            </div>

        </div>

    </section>


    <!-- =====================================================
         RSVP
    ====================================================== -->

    <section class="rsvp-section" id="rsvp">

        <div class="rsvp-inner">

            <!-- RSVP Heading -->

            <div class="rsvp-heading">

                <p class="section-label">
                    RSVP
                </p>

                <h2>
                    Will You
                    <br />
                    Join Us?
                </h2>

                <div class="gold-line"></div>

                <p>
                    We would be delighted to celebrate this
                    special day with you.
                    Please confirm your attendance below.
                </p>

            </div>


            <!-- RSVP Form -->

            <div class="rsvp-card">

                <form id="rsvpForm"
                      method="post">


                    <!-- Guest Name -->

                    <div class="form-group">

                        <label for="guestName">
                            YOUR NAME
                        </label>

                        <input type="text"
                               id="guestName"
                               name="GuestName"
                               placeholder="Enter your name"
                               autocomplete="name"
                               required />

                    </div>


                    <!-- Number of Guests -->

                    <div class="form-group">

                        <label for="guestCount">
                            NUMBER OF GUESTS
                        </label>

                        <select id="guestCount"
                                name="GuestCount"
                                required>

                            <option value="">
                                Select number of guests
                            </option>

                            <option value="1">
                                1 Guest
                            </option>

                            <option value="2">
                                2 Guests
                            </option>

                            <option value="3">
                                3 Guests
                            </option>

                            <option value="4">
                                4 Guests
                            </option>

                            <option value="5">
                                5 Guests
                            </option>

                        </select>

                    </div>


                    <!-- Attendance -->

                    <div class="form-group">

                        <label>
                            WILL YOU ATTEND?
                        </label>

                        <div class="attendance-options">

                            <label class="attendance-option">

                                <input type="radio"
                                       name="Attendance"
                                       value="Yes"
                                       required />

                                <span>
                                    YES, I'LL BE THERE
                                </span>

                            </label>


                            <label class="attendance-option">

                                <input type="radio"
                                       name="Attendance"
                                       value="No" />

                                <span>
                                    SORRY, I CAN'T
                                </span>

                            </label>

                        </div>

                    </div>


                    <!-- Message -->

                    <div class="form-group">

                        <label for="guestMessage">

                            MESSAGE

                            <span>
                                (OPTIONAL)
                            </span>

                        </label>

                        <textarea id="guestMessage"
                                  name="Message"
                                  rows="5"
                                  placeholder="Leave us a little message..."></textarea>

                    </div>


                    <!-- Submit -->

                    <button type="submit"
                            class="rsvp-submit">

                        <span>
                            CONFIRM ATTENDANCE
                        </span>

                        <i>
                            →
                        </i>

                    </button>


                    <!-- Response -->

                    <div id="rsvpMessage"
                         class="rsvp-message"
                         aria-live="polite">
                    </div>

                </form>

            </div>

        </div>

    </section>


    <!-- =====================================================
         FOOTER
    ====================================================== -->

    <footer class="wedding-footer">

        <div class="footer-monogram">
            S
            <span>&</span>
            ?
        </div>

        <p>
            WITH LOVE
        </p>

        <span>
            © 2026
        </span>

    </footer>

</main>